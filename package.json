{
  "name": "sg-transit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "lint": "node scripts/lint.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create sgtransporttime-routes --location apac --binding ROUTES_DB --update-config",
    "db:migrate:local": "wrangler d1 migrations apply sgtransporttime-routes --local",
    "db:migrate:remote": "wrangler d1 migrations apply sgtransporttime-routes --remote"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
